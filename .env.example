# Settings for the site. Copy this file to ".env" and fill it in.
# .env holds secrets: it is ignored by git and must never be shared or committed.

PORT=3000
SITE_NAME=WizardChat

# The account that verifies with this address becomes a Steward (moderator),
# able to remove any post, comment, or notice. Set it BEFORE you sign up.
ADMIN_EMAIL=

# ── Outgoing mail (SMTP) ─────────────────────────────────────────────────────
# With SMTP_HOST empty, verification codes are printed in the server console
# instead of being sent (local development only). README.md lists the values
# for common providers. After filling these in, check them with:
#     npm run mail:test you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender shown to recipients. Must be an address your provider lets you
# send from. Example:  MAIL_FROM="WizardChat <no-reply@yourdomain.com>"
MAIL_FROM=

# ── When the site is live on the internet (behind HTTPS) ─────────────────────
# NODE_ENV=production makes cookies HTTPS-only and refuses to start without
# mail settings. TRUST_PROXY=1 is needed behind a reverse proxy or host platform.
# NODE_ENV=production
# TRUST_PROXY=1
