<%# The drawing of one Emporium item (src/shop.js). Expects `item`: its key.
    The same drawing is used on a profile card and on the Emporium's counter.
    How each looks and moves is in public/css/style.css, under "Adornments". %>
<% if (item === 'gilt-border') { %>
  <span class="trim trim--gilt" aria-hidden="true"></span>
<% } else if (item === 'storm-border') { %>
  <%# Three versions of the same outline, each bent out of shape differently
      (the bolt-a, -b, and -c filters in partials/footer.ejs). They are shown
      in quick turn, which is what makes the lightning appear to move. %>
  <svg class="trim trim--storm" aria-hidden="true">
    <% for (const v of ['a', 'b', 'c']) { %>
      <g class="trim__bolt trim__bolt--<%= v %>" filter="url(#bolt-<%= v %>)">
        <rect class="trim__arc" width="100%" height="100%" rx="3" pathLength="100"/>
        <rect class="trim__core" width="100%" height="100%" rx="3" pathLength="100"/>
      </g>
    <% } %>
  </svg>
<% } else if (item === 'winged-eye') { %>
  <svg class="eye" viewBox="0 0 72 40" aria-hidden="true">
    <%# The wings are drawn once for the right side and mirrored for the left. %>
    <g transform="translate(72 0) scale(-1 1)">
      <g class="eye__wing">
        <path class="eye__feathers" d="M45 18C50 7 60 2 70 4c-3 2-4 4-4 6 2 0 3 0 4 1-3 1-5 3-5 5 2 0 3 0 4 1-3 1-6 3-7 6-4 1-10 1-17-1z"/>
        <path class="eye__quills" d="M48 19c5-6 11-10 18-12M50 21c5-3 10-5 15-6M52 22c3-1 7-2 10-2"/>
      </g>
    </g>
    <g class="eye__wing">
      <path class="eye__feathers" d="M45 18C50 7 60 2 70 4c-3 2-4 4-4 6 2 0 3 0 4 1-3 1-5 3-5 5 2 0 3 0 4 1-3 1-6 3-7 6-4 1-10 1-17-1z"/>
      <path class="eye__quills" d="M48 19c5-6 11-10 18-12M50 21c5-3 10-5 15-6M52 22c3-1 7-2 10-2"/>
    </g>
    <circle class="eye__ball" cx="36" cy="21" r="12"/>
    <path class="eye__veins" d="M25.5 18c2 .5 3 1.500 4.500 1.500M46.500 25c-2-.5-3-1.500-4.500-1.500M27 27c1.500-.5 2.500-1.500 3-2.500"/>
    <circle class="eye__iris" cx="36" cy="21" r="6"/>
    <circle class="eye__pupil" cx="36" cy="21" r="2.800"/>
    <circle class="eye__glint" cx="33.800" cy="18.800" r="1.300"/>
    <circle class="eye__lid" cx="36" cy="21" r="12.600"/>
  </svg>
<% } %>
