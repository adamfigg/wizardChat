<%- include('partials/header') %>
<div class="panel panel--narrow">
  <h1>Petition for Admission</h1>
  <p class="lede">Reading is open to all. To post, respond, or place a notice, you must be admitted as a member. A verification code will be sent to the address you provide.</p>
  <% if (error) { %><p class="notice notice--error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/signup">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field">
      <span class="field__label">The name by which you are known</span>
      <input type="text" name="name" value="<%= values.name || '' %>" minlength="3" maxlength="30" required autocomplete="nickname">
      <span class="hint">3 to 30 characters. This is displayed on your profile card.</span>
    </label>
    <label class="field">
      <span class="field__label">E-mail address</span>
      <input type="email" name="email" value="<%= values.email || '' %>" maxlength="254" required autocomplete="email">
      <span class="hint">Used only for verification and entry. It is never displayed.</span>
    </label>
    <label class="field">
      <span class="field__label">Passphrase</span>
      <input type="password" name="password" minlength="10" maxlength="200" required autocomplete="new-password">
      <span class="hint">At least 10 characters.</span>
    </label>
    <button class="btn btn--wide" type="submit">Send My Verification Code</button>
  </form>
  <p class="aside">Already a member? <a href="/login">Enter the Conclave</a>.</p>
</div>
<%- include('partials/footer') %>
