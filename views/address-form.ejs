<%- include('partials/header') %>
<p class="crumb"><a href="/addresses">← The Steward’s Addresses</a></p>
<div class="panel panel--wide">
  <h1><%= heading %></h1>
  <p class="lede">An Address stands at the head of the Gathering Hall until a newer one replaces it. Use it to set a matter before the membership.</p>
  <% if (error) { %><p class="notice notice--error" role="alert"><%= error %></p><% } %>
  <form method="post" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field">
      <span class="field__label">Title</span>
      <input type="text" name="title" value="<%= values.title || '' %>" minlength="3" maxlength="120" required>
    </label>
    <label class="field">
      <span class="field__label">Text</span>
      <textarea name="body" rows="18" minlength="20" maxlength="20000" required><%= values.body || '' %></textarea>
      <span class="hint">Leave a blank line between paragraphs. Begin a line with <code>## </code> to make it a sub-heading.</span>
    </label>
    <button class="btn btn--wide" type="submit"><%= submit %></button>
  </form>
</div>
<%- include('partials/footer') %>
